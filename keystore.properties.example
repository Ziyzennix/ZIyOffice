# Template for release signing credentials.
#
# Copy this file to `keystore.properties` in the repository ROOT and replace the
# placeholder values with the real ones for the ZIyOffice release keystore:
#
#     cp keystore.properties.example keystore.properties
#
# `keystore.properties` is gitignored (see .gitignore: /keystore.properties), so
# real credentials never enter the repository. Only commit this template.
#
# `storeFile` is resolved as a filesystem path. Use an absolute path, or a path
# relative to the repository root.
#
# If keystore.properties is absent or incomplete, release builds are produced
# UNSIGNED and `./gradlew :app:assembleRelease` fails with:
#     "Release signing is not configured: create keystore.properties from keystore.properties.example (see docs/)"

storeFile=path/to/ziyoffice-release.jks
storePassword=CHANGE_ME
keyAlias=ziyoffice
keyPassword=CHANGE_ME
